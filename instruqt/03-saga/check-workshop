#!/bin/bash
# ABOUTME: Verifies Challenge 3 — compensation stack, reverse unwind, the
# push-before-action rule, and a real run where compensations executed.
set -uo pipefail

fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

# Overridable so the same script can be exercised outside the sandbox.
EX="${WORKSHOP_EXERCISE:-/root/workshop/exercise}"
ADDR="${TEMPORAL_ADDRESS:-127.0.0.1:7233}"
NS=default
TQ=loan-underwriting

WORKFLOW="$EX/LoanUnderwritingWorkflow.cs"
[[ -f "$WORKFLOW" ]] || fail "Cannot find $WORKFLOW"

code() { sed 's|//.*||' "$1"; }
CLEAN=$(mktemp)
code "$WORKFLOW" > "$CLEAN"

# ── 1. Stubs implemented ─────────────────────────────────────────────────────
grep -q "NotImplementedException" "$CLEAN" \
    && fail "LoanUnderwritingWorkflow.cs still throws NotImplementedException. Implement the saga."
pass "Saga implemented"

# ── 2. The pattern ───────────────────────────────────────────────────────────
grep -q "Stack<Func<Task>>" "$CLEAN" \
    || fail "No Stack<Func<Task>> found. Hold your compensations on a stack."
grep -q "TryPop" "$CLEAN" \
    || fail "No TryPop found. Unwind with: while (compensations.TryPop(out var undo)) await undo();"
grep -q "catch" "$CLEAN" \
    || fail "No catch block found. Compensations run when a forward step fails."
grep -qE "^\s*throw\s*;" "$CLEAN" \
    || fail "No bare 're-throw' found in the catch. A compensated failure is still a failure."
pass "Compensation stack, reverse unwind and re-throw present"

# ── 3. The rule: register each compensation BEFORE its action ────────────────
# Compare the line where the undo is pushed with the line where the forward
# activity runs. The push must come first.
check_order() {
    local undo="$1" forward="$2" label="$3"
    local undo_line forward_line
    undo_line=$(grep -n "Push(.*${undo}" "$CLEAN" | head -1 | cut -d: -f1)
    forward_line=$(grep -n "await .*${forward}" "$CLEAN" | head -1 | cut -d: -f1)

    [[ -z "$undo_line" ]] \
        && fail "No compensation registered for ${forward} — push ${undo} onto the stack."
    [[ -z "$forward_line" ]] \
        && fail "${forward} is never called."
    [[ "$undo_line" -lt "$forward_line" ]] \
        || fail "${label}: ${undo} is pushed AFTER ${forward} runs (line $undo_line vs $forward_line). Push the compensation BEFORE the action — otherwise a crash in between loses the undo forever."
}

check_order "ReleaseCreditHoldAsync"      "PlaceCreditHoldAsync"  "Credit hold"
check_order "CancelDocumentRequestAsync"  "RequestDocumentsAsync" "Documents"
check_order "ReverseFundingAsync"         "FundLoanAsync"         "Funding"
pass "Every compensation is registered before the action it undoes"

# ── 4. Deterministic workflow APIs ───────────────────────────────────────────
for banned in "DateTime.Now" "DateTime.UtcNow" "Guid.NewGuid" "Task.Delay" "new Random" "Random.Shared"; do
    grep -qF "$banned" "$CLEAN" \
        && fail "'$banned' appears in workflow code and is not replay-safe. Use the Workflow.* equivalent."
done
pass "Workflow code is deterministic"

# ── 5. Compiles ──────────────────────────────────────────────────────────────
cd "$EX" || fail "Cannot enter $EX"
if ! dotnet build -v q --nologo >/tmp/check03-build.log 2>&1; then
    echo "--- build output ---"; tail -20 /tmp/check03-build.log
    fail "Project does not compile."
fi
pass "Project compiles"

# ── 6. Both paths actually ran ───────────────────────────────────────────────
WFIDS=$(temporal workflow list --address "$ADDR" --namespace "$NS" \
    --query "TaskQueue='$TQ'" --limit 25 --output json 2>/dev/null \
    | jq -r '.[].execution.workflowId' | head -25)

[[ -z "$WFIDS" ]] \
    && fail "No workflows found. Start the worker and run 'dotnet run -- starter'."

FUNDED=0
COMPENSATED=0
for wfid in $WFIDS; do
    HIST=$(temporal workflow show --address "$ADDR" --namespace "$NS" \
        --workflow-id "$wfid" --output json 2>/dev/null) || continue

    echo "$HIST" | jq -e '[.events[].eventType]
        | index("EVENT_TYPE_WORKFLOW_EXECUTION_COMPLETED")' >/dev/null 2>&1 && FUNDED=1

    # Activity names drop the "Async" suffix in history.
    SCHEDULED=$(echo "$HIST" | jq -r '[.events[]
        | select(.eventType == "EVENT_TYPE_ACTIVITY_TASK_SCHEDULED")
        | .activityTaskScheduledEventAttributes.activityType.name] | join(",")')

    if [[ "$SCHEDULED" == *"ReleaseCreditHold"* && "$SCHEDULED" == *"CancelDocumentRequest"* ]]; then
        COMPENSATED=1
    fi
done

[[ "$FUNDED" -eq 1 ]] \
    || fail "No successfully funded application found. Run 'dotnet run -- starter' and let it complete."
pass "A loan was funded successfully"

[[ "$COMPENSATED" -eq 1 ]] \
    || fail "No compensations found in any workflow history. Run 'dotnet run -- starter large' — \$72,000 is over the partner limit, so funding is declined and the saga should unwind."
pass "Compensations ran on the declined application"

echo "Challenge 3 complete."
exit 0
