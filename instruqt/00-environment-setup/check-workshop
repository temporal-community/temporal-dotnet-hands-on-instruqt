#!/bin/bash
set -uo pipefail
fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

ADDR="${TEMPORAL_ADDRESS:-127.0.0.1:7233}"

temporal operator cluster health --address "$ADDR" 2>/dev/null | grep -q "SERVING" \
    || fail "Temporal dev server is not healthy yet. Wait a few seconds and try again."
pass "Temporal dev server is SERVING"

dotnet --version >/dev/null 2>&1 || fail "dotnet CLI not found."
pass ".NET SDK available ($(dotnet --version))"

command -v jq >/dev/null 2>&1 || fail "jq not found — the challenge checks need it."
pass "jq available"

[[ -d /root/workshop/exercises/01_orchestrate/practice ]] \
    || fail "Workshop source is missing from /root/workshop/exercises."
pass "Workshop source staged"

echo "Environment ready."
exit 0
